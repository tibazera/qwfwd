{
  "manifest_version": 3,
  "name": "QW Mesh UDP Ping",
  "version": "0.1.0",
  "description": "Real QuakeWorld UDP measurements for QW Mesh.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tibazera.github.io/qwfwd/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
